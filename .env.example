# ═══════════════════════════════════════════════════════════════
# SOVEREIGN INTELLIGENCE TERMINAL — ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════
# Copy this file to user_data/.env and fill in your values.
# The application loads its configuration from user_data/.env
# ═══════════════════════════════════════════════════════════════

# --- LLM PROVIDER SELECTION ---
# Options: bedrock, anthropic, openai, azure
LLM_PROVIDER="bedrock"

# Two model slots:
#   AIDLC_MODEL_ID         — primary reasoning model (Opus tier recommended)
#   AIDLC_SONNET_MODEL_ID  — fast model for risk checks / data gathering
#                            (AIDLC_FAST_MODEL_ID is accepted as an alias)
#
# Format depends on LLM_PROVIDER:
#   bedrock   - inference profile ID or full ARN, e.g.
#               "global.anthropic.claude-opus-4-8-v1"     (cross-region, recommended)
#               "us.anthropic.claude-opus-4-8-v1"         (US-only)
#               "arn:aws:bedrock:us-east-1:ACCT:inference-profile/global.anthropic.claude-opus-4-8-v1"
#   anthropic - bare model id, e.g. "claude-opus-4-8" / "claude-sonnet-4-6"
#   openai    - "gpt-4o" / "gpt-4o-mini"
#   azure     - the DEPLOYMENT name you created in Azure AI Foundry,
#               e.g. "DeepSeek-V4-Pro" (primary) / "gpt-5-mini" (fast)
AIDLC_MODEL_ID="global.anthropic.claude-opus-4-8-v1"
AIDLC_SONNET_MODEL_ID="global.anthropic.claude-sonnet-4-6"

# --- ANTHROPIC (Direct API) ---
ANTHROPIC_API_KEY=""

# --- OPENAI (Direct API) ---
OPENAI_API_KEY=""

# --- AWS BEDROCK ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

# --- AZURE OPENAI / AI FOUNDRY ---  (only when LLM_PROVIDER="azure")
# Endpoint MUST be the OpenAI-compatible v1 surface of your resource:
#     https://<resource>.services.ai.azure.com/openai/v1
# Do NOT use the "/api/projects/<project>" Foundry project URL — it returns
# "API version not supported". The /openai/v1 surface needs no api-version and
# serves both Azure OpenAI models (gpt-5.x) and MaaS models (DeepSeek, grok, …).
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
# Optional: pin a separate resource/key for the fast slot (else it shares the above).
AZURE_OPENAI_ENDPOINT_FAST=""
AZURE_OPENAI_API_KEY_FAST=""
# Only needed if you use a bare resource URL instead of /openai/v1. Newer models
# (gpt-5.x / o-series) require a recent version; default is 2024-12-01-preview.
AZURE_OPENAI_API_VERSION=""

# --- COST TRACKING (optional) ---
# Usage is always tracked in tokens (accurate for any model). Cost is shown only
# when you set a price PER SLOT here — USD per 1M tokens, "input/output[/cache]".
# Leave unset to display tokens only (no estimated cost). Set to your real rates:
AIDLC_PRICE_PRIMARY=""    # e.g. "5/25"   for the primary-slot model
AIDLC_PRICE_FAST=""       # e.g. "0.15/0.60" for the fast-slot model
AIDLC_PRICE_EMBED=""      # e.g. "0.02/0"

# --- LLM RELIABILITY (optional) ---
# A 429 (TPM/RPM rate limit) fails fast by default instead of burning retries on
# a quota ceiling that won't clear in seconds. Set to 1 to restore retrying.
LLM_RETRY_RATE_LIMITS="0"

# In-app throttle governor ceiling (tokens/min) for the rolling-window meter.
# MUST match your provider deployment's real TPM quota — if it's lower, the app
# self-throttles calls the provider would accept. Default 20000.
# (AZURE_OPENAI_TPM_LIMIT is kept as a back-compat alias.)
LLM_TPM_LIMIT="20000"

# --- REASONING / "MAX THINK" (optional, provider-agnostic) ---
# One knob maps to each provider's native reasoning mechanism — there is NO
# prompt keyword (e.g. "ultrathink") for Kimi/DeepSeek/GPT/Gemini/Claude; depth
# is a request parameter. Levels: off | low | medium | high | max. Default off
# reproduces today's behavior exactly.
#   azure / openai → reasoning_effort      (DeepSeek/Kimi/gpt-5/o-series)
#   google         → thinking_budget
#   anthropic      → adaptive thinking
#   bedrock        → reasoning_config.budget_tokens
AIDLC_REASONING_EFFORT=""            # both tiers, e.g. "high" or "max"
AIDLC_REASONING_EFFORT_PRIMARY=""    # per-tier override (Deep Reasoning model)
AIDLC_REASONING_EFFORT_FAST=""       # per-tier override (planner / fast model)
#
# Output budget (max_tokens) — a CEILING, not a target (you only pay for what's
# emitted). With reasoning on, the chain-of-thought shares this budget, so the
# defaults leave headroom. DeepSeek-V4-Pro / Kimi-K2.6 accept up to 131072.
AIDLC_MAX_TOKENS=""                  # primary tier (default 16384)
AIDLC_MAX_TOKENS_FAST=""             # fast tier    (default 8192)
AIDLC_MAX_TOKENS_DEEP=""             # Deep Reasoning conclusion synthesis (default 32768)
#
# Gemini 3 (google/vertexai only) — natively combines Grounding with Google Search
# with our custom finance tools in one request. Gives the model a live-search
# fallback for anything none of our tools cover, instead of misusing a
# finance-shaped tool (e.g. search_multi_source) or fabricating an answer.
# 5,000 free grounded prompts/month, then $14/1K. Default on; set to "0" to disable.
AIDLC_GOOGLE_SEARCH_GROUNDING=""     # "0" disables; anything else (or unset) = on
#
# Azure embeddings batch size — Foundry MaaS embed deployments cap a request at
# 96 texts (Cohere-embed-v3-english). Default 96 batches the tool catalog under
# the cap; lower only if a deployment has a smaller limit.
AIDLC_EMBED_BATCH_SIZE=""            # default 96
# Escape hatch for OpenAI-compatible gateways that want a different shape than
# reasoning_effort (e.g. self-hosted DeepSeek/Kimi on vLLM/SGLang). Raw JSON
# merged into the request body; when set it REPLACES reasoning_effort. Example:
#   AIDLC_REASONING_EXTRA_BODY='{"chat_template_kwargs": {"thinking": true}}'
# NOTE: Azure AI Foundry's MaaS gateway REJECTS chat_template_kwargs (HTTP 400
# "unrecognized_request_argument", verified 2026-06-17) — there, use plain
# reasoning_effort (above), which DeepSeek-V4-Pro honors. Leave this empty.
AIDLC_REASONING_EXTRA_BODY=""

# --- FINANCIAL DATA APIS (Recommended but Optional) ---
# The system works without these but with reduced capabilities.
# All have fallback mechanisms (yfinance, web scraping, etc.)
#
# Recommended for best experience:
ALPHA_VANTAGE_API_KEY=""  # Quotes & fundamentals (falls back to yfinance)
FMP_API_KEY=""            # Insider trading, earnings, ratios (limited without)
#
# Optional enhancements:
FRED_API_KEY=""           # Macro indicators (GDP, inflation, rates)
FINNHUB_API_KEY=""        # Sentiment & analyst ratings
POLYGON_API_KEY=""        # Options chains & advanced technicals

# --- SEARCH & NEWS ---
TAVILY_API_KEY=""         # Optimized AI search

# --- BROKERAGE CONNECTIVITY ---
# Questrade (Canada)
QUESTRADE_ENABLED="false"
QUESTRADE_REFRESH_TOKEN=""
QUESTRADE_ACCOUNT_OWNER="YourName"

# Alpaca (US & Global)
ALPACA_API_KEY=""
ALPACA_SECRET_KEY=""
ALPACA_PAPER_MODE="true"

# --- SYSTEM SETTINGS ---
LOG_LEVEL="INFO"
PORT=8000
REGIONAL_LOCALE="English (Canada)"
BASE_CURRENCY="CAD"

# --- MULTI-USER AUTH (household / iOS app) ---
# Off by default: single-user local setups keep working with no login. Turn on
# only once login accounts exist (scripts/cairniq_user.py) and a login UI/app is
# ready, since it then requires a valid token on every protected route.
CAIRNIQ_AUTH_REQUIRED="false"
# Access-token lifetime in seconds (default 2592000 = 30 days).
CAIRNIQ_TOKEN_TTL="2592000"
# The HS256 signing secret is auto-generated into the OS keychain on first use;
# set it explicitly only to share one secret across hosts. Never commit a real value.
# CAIRNIQ_JWT_SECRET=""
# Bind address — keep 127.0.0.1 for local-only; set 0.0.0.0 to reach the server
# from an iPhone over your UniFi VPN/LAN.
# CAIRNIQ_HOST="127.0.0.1"

# --- PRIVATE LOCAL FEATURES ---
# Keep disabled for source-available builds. Enable only on machines where your
# private guru-picks tooling is installed.
CAIRNIQ_ENABLE_GURU_PICKS="false"
# Optional import path; when set, the quick action appears only if importable.
CAIRNIQ_GURU_PICKS_TOOL=""

# --- LLM runaway protection (circuit breaker + watchdog) ---
# Persistent, restart-safe rolling budget (agent/llm_budget.py). A cap of 0 = no
# limit for that dimension. SOFT caps -> the chat API refuses politely (429).
AIDLC_LLM_MAX_CALLS_PER_HOUR=600
AIDLC_LLM_MAX_SPEND_CAD_PER_DAY=40
# HARD caps -> the watchdog (com.cairniq.watchdog, every 2 min) DISABLES the
# server LaunchAgent so a runaway stops and stays down. Default = 2.5x soft.
AIDLC_LLM_KILL_CALLS_PER_HOUR=1500
AIDLC_LLM_KILL_SPEND_CAD_PER_DAY=100
# Watchdog behaviour
AIDLC_WATCHDOG_AUTOKILL=1        # 0 = alert only, do not auto-disable
AIDLC_WATCHDOG_MAX_RESTARTS=8    # server restarts per 2-min check that count as a storm

# Extra browser CORS origins (comma-separated), e.g. a LAN hostname http://host:8000.
# Machine-specific names live here, never hardcoded in source. Set in user_data/.env.
CAIRNIQ_EXTRA_ORIGINS=
